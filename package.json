{
  "name": "karaoke",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:prepare": "bun run db:dev:push && bun run db:dev:seed",
    "build": "vite build",
    "serve": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:dev:push": "bun --env-file=.env.local drizzle-kit push",
    "db:dev:seed": "bun run scripts/seed.ts",
    "db:gen": "bun x drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "upgrade-interactive": "bunx npm-check-updates --format group -i",
    "prepare": "husky"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@tailwindcss/vite": "^4.1.15",
    "@tanstack/react-devtools": "^0.7.7",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@tanstack/react-router": "^1.133.21",
    "@tanstack/react-router-devtools": "^1.133.21",
    "@tanstack/react-router-ssr-query": "^1.133.21",
    "@tanstack/react-start": "^1.133.21",
    "@tanstack/router-plugin": "^1.133.21",
    "@unpic/react": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.6",
    "lucide-react": "^0.546.0",
    "next-themes": "^0.4.6",
    "nextleton": "^0.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remeda": "^2.32.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.15",
    "tw-animate-css": "^1.3.6",
    "ua-parser-js": "^2.0.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@karl-run/prettier-config": "^1.1.0",
    "@tanstack/nitro-v2-vite-plugin": "^1.133.19",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.5",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.5",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2",
    "vite": "^7.1.11",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  },
  "lint-staged": {
    "*.{md,html,css,json,graphql,graphqls}": "prettier --write",
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome lint --write --no-errors-on-unmatched"
    ]
  },
  "prettier": "@karl-run/prettier-config"
}
